---
// Fernanda's photo. Until a photo is uploaded in /admin → "Sobre mí", shows elegant initials.
interface Props { photo?: string | null; name: string; size?: number }
const { photo, name, size = 300 } = Astro.props;
const initials = name.split(' ').map((w) => w[0]).slice(0, 2).join('');
---
<div class="avatar" style={`--s:${size}px`}>
  <span class="ring-a"></span>
  {photo ? <img src={photo} alt={name} width={size} height={size} loading="lazy" /> : (
    <span class="ph"><span>{initials}</span></span>
  )}
</div>

<style>
  .avatar { position: relative; width: min(var(--s), 100%); aspect-ratio: 1; }
  .ring-a { position: absolute; inset: 0; border-radius: 50%; padding: 4px;
    background: conic-gradient(from 200deg, var(--cyan) 0 48%, var(--orange) 52% 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
    filter: drop-shadow(0 0 22px rgba(41, 182, 255, 0.45)); }
  img, .ph { position: absolute; inset: 12px; width: calc(100% - 24px); height: calc(100% - 24px); border-radius: 50%; object-fit: cover; }
  .ph { display: grid; place-items: center;
    background: radial-gradient(circle at 50% 75%, rgba(255, 160, 60, 0.35), transparent 60%),
      linear-gradient(rgba(41,182,255,.1) 1px, transparent 1px) 0 0 / 26px 26px,
      linear-gradient(90deg, rgba(41,182,255,.1) 1px, transparent 1px) 0 0 / 26px 26px, #0a1224; }
  .ph span { font-family: var(--font-display); font-weight: 800; font-size: calc(var(--s) * 0.26); letter-spacing: 0.04em;
    background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
</style>
