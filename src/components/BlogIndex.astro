---
import PostCard from './PostCard.astro';
import Icon from './Icon.astro';
import { ui, type Lang } from '../i18n/ui';
import { getPosts } from '../lib/blog';
import { site } from '../site.config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const { posts, fallback } = await getPosts(lang);
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p !== featured);
const cats = [...new Set(rest.map((p) => p.data.category))];
---
<section class="b-hero">
  <div class="container">
    <span class="kicker">{t.blog.kicker}</span>
    <h1>{t.blog.indexTitle}</h1>
    <p class="lead">{t.blog.indexSub}</p>
  </div>
</section>

<section class="section" style="padding-top:20px">
  <div class="container">
    {featured ? (
      <>
        <p class="label">{t.blog.featured}</p>
        <div class="feat"><PostCard post={featured} lang={lang} fallback={fallback} variant="feature" /></div>
      </>
    ) : <p class="card" style="text-align:center;color:var(--muted)">{t.blog.empty}</p>}

    {rest.length > 0 && (
      <>
        {cats.length > 1 && (
          <div class="filters" role="group">
            <button class="on" data-cat="">{t.blog.allCats}</button>
            {cats.map((c) => <button data-cat={c}>{c}</button>)}
          </div>
        )}
        <div class="posts">
          {rest.map((p) => <div data-post-cat={p.data.category}><PostCard post={p} lang={lang} fallback={fallback} /></div>)}
        </div>
      </>
    )}

    <div class="cta">
      <div><h3>{t.blog.ctaTitle}</h3><p>{t.blog.ctaText}</p></div>
      <a class="btn btn-primary" href={site.contact.calendly} target="_blank" rel="noopener"><Icon name="calendar" /> {t.bookCall}</a>
    </div>
  </div>
</section>

<script is:inline>
  document.querySelectorAll('.filters button').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('.filters button').forEach((x) => x.classList.toggle('on', x === b));
    const c = b.dataset.cat;
    document.querySelectorAll('[data-post-cat]').forEach((el) => { el.hidden = !!c && el.dataset.postCat !== c; });
  }));
</script>

<style>
  .b-hero { position: relative; overflow: hidden; margin-top: -72px; padding: calc(72px + clamp(48px, 7vw, 90px)) 0 36px;
    background: radial-gradient(600px 300px at 85% 0%, rgba(255,122,31,.14), transparent 70%), radial-gradient(600px 300px at 5% 10%, rgba(41,182,255,.13), transparent 70%); }
  .b-hero h1 { font-size: clamp(2.6rem, 6vw, 4.2rem); margin-bottom: 14px; }
  .label { font-size: 0.85rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 14px; }
  .feat { margin-bottom: 56px; }
  .feat :global(.pc--feature) { grid-template-columns: 1.15fr 1fr; grid-template-rows: none; }
  .feat :global(.pc--feature .cover) { aspect-ratio: auto; min-height: 340px; }
  .feat :global(.pc--feature .body) { justify-content: center; padding: clamp(28px, 4vw, 48px); }
  @media (max-width: 860px) { .feat :global(.pc--feature) { grid-template-columns: 1fr; } .feat :global(.pc--feature .cover) { min-height: 0; aspect-ratio: 16 / 9; } }
  .filters { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 26px; }
  .filters button { font: inherit; font-size: 0.98rem; font-weight: 600; min-height: 44px; padding: 0 18px; border-radius: 999px; cursor: pointer; background: var(--surface); color: var(--muted); border: 1.5px solid var(--line-strong); }
  .filters button.on { background: rgba(41,182,255,.14); color: var(--text); border-color: var(--cyan); }
  .posts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .posts > div { display: grid; }
  @media (max-width: 960px) { .posts { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .posts { grid-template-columns: 1fr; } }
  .cta { margin-top: 64px; display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; padding: 30px; border-radius: var(--radius);
    background: linear-gradient(90deg, rgba(41,182,255,.1), rgba(255,122,31,.1)); border: 1px solid var(--line-strong); }
  .cta h3 { margin-bottom: 4px; } .cta p { margin: 0; color: var(--muted); }
</style>
