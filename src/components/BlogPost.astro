---
import { render } from 'astro:content';
import Icon from './Icon.astro';
import Avatar from './Avatar.astro';
import PostCard from './PostCard.astro';
import { ui, paths, type Lang } from '../i18n/ui';
import { readingTime, formatDate, postHref, getTranslation, getRelated, getAbout, type Post } from '../lib/blog';
import { site, whatsappLink } from '../site.config';

interface Props { post: Post; lang: Lang }
const { post, lang } = Astro.props;
const t = ui[lang];
const { Content } = await render(post);
const { title, description, date, category, cover } = post.data;
const translation = await getTranslation(post);
const related = await getRelated(post);
const about = await getAbout(lang);
const photo = about?.data.photo;
const url = new URL(postHref(post), site.url).href;
---
<div class="progress" aria-hidden="true"><span data-progress></span></div>

<article>
  <header class="post-hero">
    <div class="container narrow">
      <a class="back" href={paths[lang].blog}><Icon name="arrow" size={16} class="flip" /> {t.blog.back}</a>
      <p class="cat">{category}</p>
      <h1>{title}</h1>
      {description && <p class="dek">{description}</p>}
      <div class="byline">
        <a class="by-av" href={paths[lang].about}><Avatar photo={photo} name="Fernanda Chima" size={52} /></a>
        <div>
          <a class="by-name" href={paths[lang].about}>{t.blog.by} Fernanda Chima</a>
          <span>{formatDate(date, post.data.lang)} · {readingTime(post)} {t.blog.min}</span>
        </div>
        {translation && <a class="tr" href={postHref(translation)} hreflang={translation.data.lang}><Icon name="globe" size={16} /> {t.blog.readIn}</a>}
      </div>
    </div>
  </header>

  <div class="container narrow">
    {cover && <img class="cover" src={cover} alt="" />}
    <div class="prose"><Content /></div>

    <div class="share">
      <span>{lang === 'es' ? 'Compartir' : 'Share'}</span>
      <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" size={20} /></a>
      <a href={`https://wa.me/?text=${encodeURIComponent(title + ' ' + url)}`} target="_blank" rel="noopener" aria-label="WhatsApp"><Icon name="whatsapp" size={20} /></a>
      <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" size={20} /></a>
    </div>

    <aside class="author">
      <Avatar photo={photo} name="Fernanda Chima" size={96} />
      <div>
        <b>Fernanda Chima</b>
        <span class="r">{t.blog.authorRole}</span>
        <p>{about?.data.intro}</p>
        <a href={paths[lang].about}>{t.blog.authorMore} <Icon name="arrow" size={16} /></a>
      </div>
    </aside>

    <aside class="next">
      <h3>{t.blog.ctaTitle}</h3>
      <p>{t.blog.ctaText}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={site.contact.calendly} target="_blank" rel="noopener"><Icon name="calendar" /> {t.bookCall}</a>
        <a class="btn btn-wa" href={whatsappLink(t.whatsappMsg)} target="_blank" rel="noopener"><Icon name="whatsapp" /> {t.whatsapp}</a>
      </div>
    </aside>
  </div>

  {related.length > 0 && (
    <section class="container related">
      <h2>{t.blog.related}</h2>
      <div class="rel-grid">{related.map((p) => <PostCard post={p} lang={lang} />)}</div>
    </section>
  )}
  <div class="container narrow" style="padding-bottom:80px"><a class="back" href={paths[lang].blog}><Icon name="arrow" size={16} class="flip" /> {t.blog.back}</a></div>
</article>

<script is:inline>
  (() => {
    const bar = document.querySelector('[data-progress]');
    const art = document.querySelector('.prose');
    const upd = () => {
      const r = art.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (window.innerHeight - r.top) / (r.height + window.innerHeight * 0.4)));
      bar.style.transform = `scaleX(${p})`;
    };
    upd(); addEventListener('scroll', upd, { passive: true }); addEventListener('resize', upd);
  })();
</script>

<style>
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 70; }
  .progress span { display: block; height: 100%; background: var(--grad); transform-origin: left; transform: scaleX(0); }
  .narrow { max-width: 760px; }
  .post-hero { position: relative; margin-top: -72px; padding: calc(72px + clamp(40px, 6vw, 70px)) 0 36px;
    background: radial-gradient(600px 320px at 85% 0%, rgba(255,122,31,.13), transparent 70%), radial-gradient(600px 320px at 5% 10%, rgba(41,182,255,.12), transparent 70%); }
  .back { display: inline-flex; align-items: center; gap: 8px; color: var(--cyan); text-decoration: none; font-weight: 600; }
  .back :global(.flip) { transform: rotate(180deg); }
  .cat { margin: 34px 0 12px; font-size: 0.85rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--orange); }
  .post-hero h1 { font-size: clamp(2.1rem, 5vw, 3.4rem); line-height: 1.08; margin-bottom: 18px; text-wrap: balance; }
  .dek { font-family: var(--font-serif); font-size: clamp(1.15rem, 2vw, 1.35rem); line-height: 1.55; color: #c5d0e2; margin-bottom: 28px; }
  .byline { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; padding-top: 22px; border-top: 1px solid var(--line); }
  .by-av { width: 52px; flex: none; text-decoration: none; }
  .by-av :global(.ph span) { font-size: 15px !important; }
  .byline > div { flex: 1 1 180px; min-width: 0; }
  .by-name { display: block; font-weight: 700; text-decoration: none; }
  .byline span { color: var(--muted); font-size: 0.92rem; }
  .tr { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 16px; border-radius: 999px; border: 1.5px solid var(--line-strong); text-decoration: none; font-weight: 600; font-size: 0.95rem; }
  .tr:hover { border-color: var(--orange); }
  @media (max-width: 560px) { .tr { margin-left: 0; } }
  .cover { border-radius: var(--radius); margin: 8px 0 36px; border: 1px solid var(--line); width: 100%; }
  .prose { margin-top: 12px; }
  .share { display: flex; align-items: center; gap: 10px; margin: 40px 0; padding: 18px 0; border-block: 1px solid var(--line); color: var(--muted); font-weight: 600; }
  .share a { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--line-strong); color: var(--text); }
  .share a:hover { border-color: var(--cyan); color: var(--cyan); }
  .author { display: flex; gap: 22px; align-items: flex-start; padding: 26px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); }
  .author > :global(.avatar) { flex: 0 0 96px; }
  .author :global(.ph span) { font-size: 26px !important; }
  .author b { font-family: var(--font-display); font-size: 1.25rem; display: block; }
  .author .r { color: var(--orange); font-weight: 600; font-size: 0.95rem; }
  .author p { color: var(--muted); margin: 10px 0; font-size: 1rem; }
  .author a { display: inline-flex; gap: 6px; align-items: center; color: var(--cyan); font-weight: 700; text-decoration: none; }
  @media (max-width: 560px) { .author { flex-direction: column; } }
  .next { margin-top: 24px; padding: 30px; border-radius: var(--radius); background: linear-gradient(90deg, rgba(41,182,255,.1), rgba(255,122,31,.1)); border: 1px solid var(--line-strong); }
  .next p { color: #c5d0e2; }
  .related { margin-top: 80px; margin-bottom: 40px; }
  .related h2 { font-size: 1.8rem; }
  .rel-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 22px; }
</style>
