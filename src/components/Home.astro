---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import PostCard from './PostCard.astro';
import Avatar from './Avatar.astro';
import { ui, paths, type Lang } from '../i18n/ui';
import { site, whatsappLink } from '../site.config';
import { getPosts, getAbout } from '../lib/blog';
import { human } from '../i18n/human';
import { mission } from '../i18n/mission';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const P = paths[lang];
const es = lang === 'es';
const h = human[lang];
const ms = mission[lang];
const chooserHref = { guia: site.tools.guia, cotizador: site.tools.cotizador, solicitud: site.tools.solicitud, blog: P.blog } as const;
const { posts, fallback } = await getPosts(lang);
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const others = posts.filter((p) => p !== featured).slice(0, 2);
const about = await getAbout(lang);
const testimonials = (await getCollection('testimonials', ({ data }) => data.published)).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const toolHref = { guia: site.tools.guia, cotizador: site.tools.cotizador, solicitud: site.tools.solicitud, call: site.contact.calendly } as const;
const socials = [
  { key: 'instagram', name: 'Instagram', href: site.social.instagram, handle: site.social.instagramHandle },
  { key: 'tiktok', name: 'TikTok', href: site.social.tiktok, handle: site.social.tiktokHandle },
  { key: 'facebook', name: 'Facebook', href: site.social.facebook, handle: 'InnovationsMX' },
  { key: 'linkedin', name: 'LinkedIn', href: site.social.linkedin, handle: 'InnovationsMX' },
] as const;
---

<!-- ═════════ HERO ═════════ -->
<section class="hero" id="inicio">
  <div class="container hero-grid">
    <div class="hero-copy">
      <a class="hello" href={P.about}>
        <img src={about?.data.photo ?? '/images/logo.webp'} alt="" width="40" height="40" />
        <span>{h.hello} <span class="wave" aria-hidden="true">👋</span></span>
      </a>
      <h1>{t.hero.title[0]} <span class="grad-text">{t.hero.title[1]}</span></h1>
      <p class="lead">{h.heroSub}</p>
      <div class="btn-row">
        <a class="btn btn-orange" href="#empecemos">{t.hero.cta} <Icon name="arrow-down" /></a>
        <a class="btn btn-ghost" href={site.contact.calendly} target="_blank" rel="noopener"><Icon name="calendar" /> {t.bookCall}</a>
      </div>
    </div>
    <figure class="hero-photo">
      <span class="hp-ring" aria-hidden="true"></span>
      <img src="/images/photos/hero-almacen.webp" alt={h.heroCaption} width="900" height="1125" fetchpriority="high" />
      <figcaption>{h.heroCaption}</figcaption>
      <img class="hp-badge" src="/images/logo.webp" alt="" width="84" height="84" />
    </figure>
  </div>

  <div class="container">
    <dl class="proof">
      {t.proof.map((p) => <div><dt>{p.v}</dt><dd>{p.l}</dd></div>)}
    </dl>
  </div>
</section>

<!-- ═════════ CHOOSER ═════════ -->
<section class="section chooser-sec" id="empecemos">
  <div class="container">
    <div class="section-head center reveal">
      <span class="kicker">{h.chooser.kicker}</span>
      <h2>{h.chooser.title}</h2>
    </div>
    <div class="chooser reveal" data-chooser>
      <div class="ch-tabs" role="tablist">
        {h.chooser.options.map((o, i) => (
          <button role="tab" id={`ch-t${i}`} aria-controls={`ch-p${i}`} aria-selected={i === 0 ? 'true' : 'false'} data-i={i}>
            <Icon name={o.icon} size={24} /><span>{o.label}</span>
          </button>
        ))}
      </div>
      {h.chooser.options.map((o, i) => (
        <div class="ch-panel" role="tabpanel" id={`ch-p${i}`} aria-labelledby={`ch-t${i}`} hidden={i !== 0}>
          <img src={about?.data.photo ?? '/images/logo.webp'} alt="" width="64" height="64" class="ch-face" />
          <div>
            <p>{o.text}</p>
            <div class="btn-row">
              <a class="btn btn-orange" href={chooserHref[o.href]} target={o.href === 'blog' ? undefined : '_blank'} rel="noopener">{o.cta} <Icon name="arrow" /></a>
              <a class="ch-call" href={site.contact.calendly} target="_blank" rel="noopener"><Icon name="calendar" size={18} /> {h.chooser.call} {t.bookCall}</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ═════════ STORY ═════════ -->
<section class="section story" id="historia">
  <div class="container">
    <div class="head-row reveal">
      <div>
        <span class="kicker">{h.story.kicker}</span>
        <h2>{h.story.title}</h2>
      </div>
      <a class="btn btn-ghost" href={P.about}>{h.story.more} <Icon name="arrow" /></a>
    </div>
    <ol class="chapters hscroll">
      {h.story.chapters.map((c) => (
        <li class="chapter reveal">
          <figure>
            <img src={c.photo} alt={c.caption} loading="lazy" width="600" height="750" />
            <figcaption>{c.caption}</figcaption>
          </figure>
          <span class="ch-tag">{c.tag}</span>
          <h3>{c.title}</h3>
          <p>{c.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- ═════════ FACTORY FLOOR ═════════ -->
<section class="section floor" id="fabrica">
  <div class="container">
    <div class="section-head split-head reveal">
      <div><span class="kicker">{h.floor.kicker}</span><h2>{h.floor.title}</h2></div>
      <p class="lead">{h.floor.sub}</p>
    </div>
    <div class="floor-grid hscroll">
      {h.floor.items.map((m) => (
        <figure class="tile reveal">
          {m.type === 'video' ? (
            <video src={m.src} poster={m.poster} autoplay muted loop playsinline preload="metadata" aria-label={m.caption}></video>
          ) : (
            <img src={m.src} alt={m.caption} loading="lazy" />
          )}
          {m.type === 'video' && <span class="live"><span></span>{es ? 'Video' : 'Video'}</span>}
          <figcaption>{m.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<!-- ═════════ MISSION TEASER ═════════ -->
<section class="mission-band">
  <div class="container mb-grid reveal">
    <div class="mb-photos" aria-hidden="true">
      <img src="/images/mision/acuerdo-canton-fair.webp" alt="" loading="lazy" class="p1" />
      <img src="/images/mision/recorrido-fabrica.webp" alt="" loading="lazy" class="p2" />
      <img src="/images/mision/guangzhou-noche.webp" alt="" loading="lazy" class="p3" />
    </div>
    <div>
      <span class="kicker">{ms.kicker}</span>
      <h2>{ms.title}</h2>
      <p class="lead">{ms.sub}</p>
      <div class="mb-date"><span>{ms.next}</span><b>{ms.dates}</b><small>{ms.phase} · {ms.cities}</small></div>
      <div class="btn-row">
        <a class="btn btn-orange" href={P.mission}>{ms.teaserCta} <Icon name="arrow" /></a>
        <a class="btn btn-ghost" href={whatsappLink(ms.waMsg)} target="_blank" rel="noopener"><Icon name="whatsapp" /> {ms.cta}</a>
      </div>
    </div>
  </div>
</section>

{!es && (
  /* ═════════ EN · SERVICES ═════════ */
  <section class="section" id="servicios">
    <div class="container">
      <div class="section-head split-head reveal">
        <div><span class="kicker">{t.services.kicker}</span><h2>{t.services.title}</h2></div>
        <p class="lead">{t.services.sub}</p>
      </div>
      <div class="services hscroll">
        {t.services.items.map((s, i) => (
          <a class="svc reveal" href={toolHref[s.tool]} target="_blank" rel="noopener">
            <span class="svc-n">0{i + 1}</span>
            <span class="ic-box"><Icon name={s.icon} size={26} /></span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <span class="svc-go">{t.services.toolLabel[s.tool]} <Icon name="arrow" size={16} /></span>
          </a>
        )
)}
      </div>
    </div>
  </section>
)}

<!-- ═════════ BLOG / INSIGHTS ═════════ -->
<section class="section section--alt" id="blog">
  <div class="container">
    <div class="head-row reveal">
      <div>
        <span class="kicker">{t.blog.kicker}</span>
        <h2>{t.blog.title}</h2>
        <p class="lead">{t.blog.sub}</p>
      </div>
      {posts.length > 0 && <a class="btn btn-ghost" href={P.blog}>{t.blog.all} <Icon name="arrow" /></a>}
    </div>
    {featured ? (
      <div class={`blog-grid ${others.length ? '' : 'solo'}`}>
        <PostCard post={featured} lang={lang} fallback={fallback} variant="feature" />
        {others.length > 0 && <div class="blog-side">{others.map((p) => <PostCard post={p} lang={lang} fallback={fallback} variant="row" />)}</div>}
      </div>
    ) : <p class="card empty">{t.blog.empty}</p>}
  </div>
</section>

<!-- ═════════ TOOLS ═════════ -->
<section class="section" id="herramientas">
  <div class="container">
    <div class="section-head center reveal">
      <span class="kicker">{t.tools.kicker}</span>
      <h2>{t.tools.title}</h2>
      <p class="lead">{t.tools.sub}</p>
    </div>
    <div class="tools">
      {(['guia', 'cotizador'] as const).map((k) => {
        const tool = t.tools[k];
        return (
          <article class={`tool reveal tool--${k}`}>
            <div class="tool-art" aria-hidden="true">
              {k === 'guia' ? (
                <div class="mini-steps">{['Mercado', 'Fábrica', 'Costo', 'Ejemplos', 'Asesoría'].map((s, i) => <span class={i === 1 ? 'on' : ''}><i>{i + 1}</i>{s}</span>)}</div>
              ) : (
                <div class="mini-calc">
                  <span class="q"><Icon name="search" size={16} /> {es ? 'audífonos inalámbricos' : 'wireless earbuds'}</span>
                  {[72, 42, 30].map((w) => <span class="b" style={`--w:${w}%`}></span>)}
                  <span class="tot">$ · · ·</span>
                </div>
              )}
            </div>
            <div class="tool-body">
              <span class="badge">{tool.step}</span>
              <h3>{tool.title}</h3>
              <p>{tool.text}</p>
              <ul>{tool.points.map((x) => <li><Icon name="check" size={18} /> {x}</li>)}</ul>
              <a class="btn btn-primary" href={site.tools[k]} target="_blank" rel="noopener">{tool.cta} <Icon name="external" size={18} /></a>
              {!es && <small class="note">{t.toolLang}</small>}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<!-- ═════════ QUOTE ═════════ -->
<section class="section quote-sec" id="cotizacion">
  <div class="container">
    <div class="quote reveal">
      <div class="quote-copy">
        <span class="kicker">{t.quote.kicker}</span>
        <h2>{t.quote.title}</h2>
        <p class="lead">{t.quote.sub}</p>
        <div class="btn-row">
          <a class="btn btn-orange" href={site.tools.solicitud} target="_blank" rel="noopener"><Icon name="box" /> {t.quote.cta}</a>
          <a class="btn btn-wa" href={whatsappLink(t.whatsappMsg)} target="_blank" rel="noopener"><Icon name="whatsapp" /> {t.whatsapp}</a>
        </div>
      </div>
      <div class="quote-side">
        <b>{t.quote.need}</b>
        <ul>{t.quote.needs.map((n) => <li><Icon name="check" size={18} /> {n}</li>)}</ul>
        <p>{t.quote.min}</p>
        <div class="ship">
          <small>{t.quote.shipTitle}</small>
          <p><strong>🇲🇽 {t.quote.main}</strong> · 🇵🇪 {t.quote.list[0]} · 🇨🇴 {t.quote.list[1]} · 🇵🇦 {t.quote.list[2]} · 🇨🇱 {t.quote.list[3]}</p>
          <small class="far"><Icon name="globe" size={14} /> {t.quote.far}</small>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═════════ FEARS ═════════ -->
<section class="section section--alt" id="clientes">
  <div class="container">
    <div class="head-row reveal">
      <div>
        <span class="kicker">{h.fears.kicker}</span>
        <h2>{h.fears.title}</h2>
      </div>
      <a class="btn btn-ghost" href={P.clients}>{h.fears.clients} <Icon name="arrow" /></a>
    </div>
    <div class="fears hscroll">
      {h.fears.items.map((f) => (
        <div class="fear reveal">
          <p class="fq">“{f.q}”</p>
          <p class="fa"><Icon name="check" size={20} /> {f.a}</p>
        </div>
      ))}
    </div>
    {testimonials.length > 0 && (
      <div class="testis">
        {testimonials.map((x) => (
          <figure class="testi reveal">
            <blockquote>“{!es && x.data.quote_en ? x.data.quote_en : x.data.quote_es}”</blockquote>
            <figcaption><b>{x.data.name}</b> · {[x.data.business, x.data.city].filter(Boolean).join(', ')}</figcaption>
          </figure>
        ))}
      </div>
    )}
  </div>
</section>

<!-- ═════════ LETTER ═════════ -->
<section class="section letter-sec" id="sobre-mi">
  <div class="container">
    <article class="letter reveal">
      <div class="l-photo">
        <img src="/images/photos/omc-ginebra.webp" alt="Fernanda Chima en la OMC" loading="lazy" width="768" height="1024" />
      </div>
      <div class="l-body">
        <span class="l-kicker">{h.letter.kicker}</span>
        <p class="l-greet">{h.letter.greeting}</p>
        {h.letter.paragraphs.map((x) => <p>{x}</p>)}
        <p class="l-close">{h.letter.closing}</p>
        <p class="l-sign">{h.letter.sign}</p>
        <p class="l-role">Fernanda Chima · {h.letter.role}</p>
        <a class="l-more" href={P.about}>{t.aboutTeaser.cta} <Icon name="arrow" size={18} /></a>
      </div>
    </article>
  </div>
</section>

<!-- ═════════ SOCIAL (compact) ═════════ -->
<section class="social-band">
  <div class="container social-inner reveal">
    <div>
      <span class="kicker">{t.social.kicker}</span>
      <h3>{t.social.title}</h3>
    </div>
    <div class="soc-row">
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener" aria-label={`${s.name} ${s.handle}`}>
          <Icon name={s.key} size={22} /><span>{s.name}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ═════════ FAQ ═════════ -->
<section class="section" id="faq">
  <div class="container narrow">
    <div class="section-head center reveal"><h2>{t.faq.title}</h2></div>
    <div class="faq">
      {t.faq.items.map((f) => (
        <details class="reveal">
          <summary>{f.q}<Icon name="plus" size={22} /></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- ═════════ CONTACT ═════════ -->
<section class="section contact" id="contacto">
  <div class="grid-floor"></div>
  <div class="container">
    <div class="section-head center reveal">
      <span class="kicker">{t.contact.kicker}</span>
      <h2>{t.contact.title}</h2>
      <p class="human-line"><img src={about?.data.photo ?? '/images/logo.webp'} alt="" width="44" height="44" /> {h.contactHuman}</p>
    </div>
    <div class="contact-grid">
      <a class="c-card reveal" href={site.contact.calendly} target="_blank" rel="noopener">
        <span class="c-ic cyan"><Icon name="calendar" size={30} /></span>
        <h3>{t.contact.callTitle}</h3>
        <p>{t.contact.callText}</p>
        <small>{site.contact.hours[lang]}</small>
        <span class="btn btn-primary">{t.bookCall} <Icon name="arrow" /></span>
      </a>
      <a class="c-card reveal" href={whatsappLink(t.whatsappMsg)} target="_blank" rel="noopener">
        <span class="c-ic green"><Icon name="whatsapp" size={30} /></span>
        <h3>{t.contact.waTitle}</h3>
        <p>{t.contact.waText}</p>
        <small>{site.contact.whatsappDisplay}</small>
        <span class="btn btn-wa">{t.whatsapp} <Icon name="arrow" /></span>
      </a>
    </div>
    <p class="mail reveal"><Icon name="mail" size={20} /> {t.contact.email} <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
  </div>
</section>

<script is:inline>
  document.querySelectorAll('[data-chooser]').forEach((root) => {
    const tabs = root.querySelectorAll('[role=tab]');
    const panels = root.querySelectorAll('[role=tabpanel]');
    const pick = (i) => {
      tabs.forEach((t, k) => t.setAttribute('aria-selected', String(k === i)));
      panels.forEach((p, k) => (p.hidden = k !== i));
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pick(i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          const n = (i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length;
          tabs[n].focus(); pick(n);
        }
      });
    });
  });
</script>

<style>
  /* HERO */
  .hero { position: relative; overflow: hidden; margin-top: -72px; padding: calc(72px + clamp(28px, 5vw, 64px)) 0 clamp(48px, 6vw, 72px); }
  .hero::before { content: ''; position: absolute; inset: 0; pointer-events: none; background:
      radial-gradient(640px 460px at 80% 35%, rgba(255, 150, 60, 0.18), transparent 70%),
      radial-gradient(700px 500px at 5% 15%, rgba(41, 182, 255, 0.13), transparent 70%); }
  .hero-grid { position: relative; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(32px, 5vw, 64px); align-items: center; }
  .hello { display: inline-flex; align-items: center; gap: 10px; padding: 5px 16px 5px 5px; margin-bottom: 22px; border-radius: 999px; text-decoration: none; background: rgba(255,255,255,.06); border: 1px solid var(--line-strong); font-weight: 600; }
  .hello img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; border: 2px solid var(--orange); }
  .hello:hover { border-color: var(--orange); }
  .wave { display: inline-block; transform-origin: 70% 70%; animation: wave 2.6s ease-in-out 1s 2; }
  @keyframes wave { 0%,60%,100% { transform: rotate(0); } 10%,30% { transform: rotate(16deg); } 20%,40% { transform: rotate(-8deg); } }
  .hero h1 { margin-bottom: 20px; text-wrap: balance; }
  .hero .lead { font-size: clamp(1.08rem, 1.5vw, 1.22rem); margin-bottom: 30px; color: #c9d3e3; }
  .hero-photo { position: relative; margin: 0; justify-self: center; width: min(440px, 100%); }
  .hero-photo > img:first-of-type { position: relative; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 28px; box-shadow: 0 40px 80px -30px rgba(0,0,0,.8); }
  .hp-ring { position: absolute; inset: -10px; border-radius: 34px; background: conic-gradient(from 200deg, var(--cyan) 0 45%, var(--orange) 55% 100%); filter: blur(.5px); opacity: .9; }
  .hp-ring::after { content: ''; position: absolute; inset: -30px; border-radius: 50px; background: inherit; filter: blur(40px); opacity: .35; z-index: -1; }
  .hero-photo figcaption { position: absolute; left: 18px; bottom: 18px; right: 90px; padding: 8px 14px; border-radius: 12px; background: rgba(5,9,20,.78); backdrop-filter: blur(8px); font-family: var(--font-hand); font-size: 1.35rem; line-height: 1.15; color: #ffe1c4; }
  .hp-badge { position: absolute; right: -16px; bottom: -16px; width: 84px; height: 84px; border-radius: 50%; box-shadow: 0 10px 30px rgba(0,0,0,.6); }

  .proof { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: clamp(44px, 6vw, 72px) 0 0; border: 1px solid var(--line); border-radius: var(--radius); background: rgba(12, 21, 40, 0.7); backdrop-filter: blur(8px); }
  .proof div { padding: 22px 24px; }
  .proof div + div { border-left: 1px solid var(--line); }
  .proof dt { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.7rem, 3vw, 2.3rem); line-height: 1; background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; width: fit-content; }
  .proof dd { margin: 8px 0 0; color: var(--muted); font-size: 0.95rem; line-height: 1.4; }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-photo { order: -1; width: 100%; max-width: 520px; justify-self: stretch; }
    .hero-photo > img:first-of-type { aspect-ratio: 5 / 4; object-position: 50% 70%; }
    .hp-ring { inset: -6px; }
    .hp-badge { width: 64px; height: 64px; right: 10px; bottom: -20px; }
    .proof { grid-template-columns: 1fr 1fr; }
    .proof div:nth-child(3) { border-left: 0; }
    .proof div:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 600px) {
    .proof div { padding: 16px; }
    .btn-row .btn { flex: 1 1 100%; }
    .hero-photo figcaption { font-size: 1.15rem; left: 12px; bottom: 12px; }
  }

  /* CHOOSER */
  .chooser { max-width: 980px; margin: 0 auto; border-radius: 26px; border: 1px solid var(--line-strong); background: linear-gradient(180deg, var(--surface-2), var(--surface)); overflow: hidden; }
  .ch-tabs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-bottom: 1px solid var(--line); }
  .ch-tabs button { font: inherit; cursor: pointer; display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding: 22px 20px; min-height: 120px; text-align: left; font-weight: 600; font-size: 1rem; line-height: 1.3; color: var(--muted); background: none; border: 0; border-bottom: 3px solid transparent; transition: background .2s, color .2s; }
  .ch-tabs button + button { border-left: 1px solid var(--line); }
  .ch-tabs button:hover { color: var(--text); background: rgba(255,255,255,.03); }
  .ch-tabs button[aria-selected='true'] { color: var(--text); background: rgba(255,122,31,.08); border-bottom-color: var(--orange); }
  .ch-tabs button[aria-selected='true'] :global(svg) { color: var(--orange); }
  .ch-panel { display: flex; gap: 22px; align-items: flex-start; padding: clamp(24px, 4vw, 40px); }
  .ch-panel[hidden] { display: none; }
  .ch-face { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; flex: none; border: 2px solid var(--orange); }
