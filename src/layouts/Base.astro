---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { ui, paths, type Lang } from '../i18n/ui';
import { site, whatsappLink } from '../site.config';
import { mission } from '../i18n/mission';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  altHref: string; // same page in the other language
  image?: string;
}
const { lang, title, description, altHref, image = '/images/og.jpg' } = Astro.props;
const t = ui[lang];
const home = paths[lang].home;
const isHome = Astro.url.pathname === home || Astro.url.pathname === home.replace(/\/$/, '');
const a = (id: string) => (isHome ? `#${id}` : `${home}#${id}`);
const pageTitle = title ? `${title} · InnovationsMX` : t.metaTitle;
const desc = description || t.metaDesc;
const canonical = new URL(Astro.url.pathname, site.url).href;
const P = paths[lang];
const navItems = [
  { href: a(lang === 'es' ? 'herramientas' : 'servicios'), label: t.nav.services },
  { href: P.blog, label: t.nav.blog },
  { href: P.mission, label: mission[lang].nav },
  { href: P.clients, label: t.nav.clients },
  { href: P.about, label: t.nav.about },
  { href: a('contacto'), label: t.nav.contact },
];
const current = Astro.url.pathname;
---
<!doctype html>
<html lang={t.htmlLang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === 'es' ? 'en' : 'es'} href={new URL(altHref, site.url).href} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#050914" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={new URL(image, site.url).href} />
    <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@600;700;800&family=Inter:wght@400;500;600;700&family=Caveat:wght@500;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>

    <header class="site-header" data-header>
      <div class="container bar">
        <a class="brand" href={home} aria-label="InnovationsMX">
          <img src="/images/logo.webp" alt="" width="44" height="44" />
          <span>INNOVATIONS<b>MX</b></span>
        </a>

        <nav class="nav" aria-label="Main" data-nav>
          {navItems.map((n) => <a href={n.href} aria-current={current.startsWith(n.href) && n.href !== P.home ? 'page' : undefined}>{n.label}</a>)}
          <a class="btn btn-primary btn-sm nav-cta" href={site.contact.calendly} target="_blank" rel="noopener">
            <Icon name="calendar" size={18} /> {t.bookCall}
          </a>
        </nav>

        <div class="bar-right">
          <a class="lang" href={altHref} hreflang={lang === 'es' ? 'en' : 'es'} aria-label={t.switchLabel}>
            <Icon name="globe" size={18} /> {t.switchShort}
          </a>
          <button class="menu-btn" type="button" aria-label="Menu" aria-expanded="false" data-menu>
            <Icon name="menu" size={26} class="i-open" />
            <Icon name="close" size={26} class="i-close" />
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container foot-grid">
        <div class="foot-brand">
          <img src="/images/logo.webp" alt="InnovationsMX" width="88" height="88" />
          <p class="motto">{site.motto[lang]}</p>
        </div>
        <div>
          <h4>{t.footer.explore}</h4>
          <ul>
            <li><a href={P.blog}>{t.nav.blog}</a></li>
            <li><a href={P.mission}>{mission[lang].nav}</a></li>
            <li><a href={P.clients}>{t.nav.clients}</a></li>
            <li><a href={P.about}>{t.nav.about}</a></li>
            <li><a href={site.tools.guia} target="_blank" rel="noopener">{t.tools.guia.title}</a></li>
            <li><a href={site.tools.cotizador} target="_blank" rel="noopener">{t.tools.cotizador.title}</a></li>
            <li><a href={site.tools.solicitud} target="_blank" rel="noopener">{t.footer.quote}</a></li>
          </ul>
        </div>
        <div>
          <h4>{t.footer.contact}</h4>
          <ul>
            <li><a href={site.contact.calendly} target="_blank" rel="noopener">{t.bookCall}</a></li>
            <li><a href={whatsappLink(t.whatsappMsg)} target="_blank" rel="noopener">{site.contact.whatsappDisplay}</a></li>
            <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
          </ul>
        </div>
        <div>
          <h4>{t.footer.follow}</h4>
          <div class="foot-social">
            <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" /></a>
            <a href={site.social.tiktok} target="_blank" rel="noopener" aria-label="TikTok"><Icon name="tiktok" /></a>
            <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" /></a>
            <a href={site.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" /></a>
          </div>
        </div>
      </div>
      <div class="container foot-bottom">
        <span>© 2026 InnovationsMX · {t.footer.made}</span>
        <a href={altHref}>{t.switchLabel}</a>
      </div>
    </footer>

    <a class="wa-float" href={whatsappLink(t.whatsappMsg)} target="_blank" rel="noopener" aria-label={t.whatsapp}>
      <Icon name="whatsapp" size={30} />
      <span>{t.whatsappShort}</span>
    </a>

    <script is:inline>
      (() => {
        const header = document.querySelector('[data-header]');
        const btn = document.querySelector('[data-menu]');
        const nav = document.querySelector('[data-nav]');
        const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 10);
        onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
        const close = () => { header.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); };
        btn.addEventListener('click', () => {
          const open = header.classList.toggle('open');
          btn.setAttribute('aria-expanded', String(open));
        });
        nav.querySelectorAll('a').forEach((l) => l.addEventListener('click', close));
        const io = 'IntersectionObserver' in window && new IntersectionObserver((es) => {
          es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
        document.querySelectorAll('.reveal').forEach((el) => io ? io.observe(el) : el.classList.add('is-in'));
      })();
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 8px; background: var(--cyan); color: #000; padding: 8px 14px; border-radius: 8px; z-index: 100; }
  .skip:focus { left: 8px; }

  .site-header { position: sticky; top: 0; z-index: 50; transition: background 0.25s, border-color 0.25s; border-bottom: 1px solid transparent; }
  .site-header.scrolled, .site-header.open { background: rgba(5, 9, 20, 0.88); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-color: var(--line); }
  .bar { display: flex; align-items: center; gap: 20px; height: 72px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--font-display); font-weight: 800; letter-spacing: 0.06em; font-size: 1.05rem; }
  .brand img { width: 44px; height: 44px; border-radius: 50%; }
  .brand b { color: var(--orange); margin-left: 4px; }
  .nav { display: flex; align-items: center; gap: 4px; margin-left: auto; }
  .nav > a:not(.btn) { text-decoration: none; padding: 10px 10px; white-space: nowrap; border-radius: 10px; color: var(--muted); font-weight: 500; font-size: 1rem; }
  .nav > a:not(.btn):hover, .nav > a[aria-current] { color: var(--text); background: rgba(255,255,255,0.05); }
  .nav-cta { margin-left: 8px; }
  .bar-right { display: flex; align-items: center; gap: 8px; }
  .lang { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; font-weight: 700; font-size: 0.95rem; padding: 9px 14px; border-radius: 999px; border: 1.5px solid var(--line-strong); }
  .lang:hover { border-color: var(--orange); color: #ffb27a; }
  .menu-btn { display: none; background: none; border: 0; color: var(--text); padding: 8px; cursor: pointer; }
  .menu-btn :global(.i-close) { display: none; }

  @media (max-width: 1100px) {
    .menu-btn { display: inline-flex; }
    .nav { position: fixed; inset: 72px 0 auto 0; flex-direction: column; align-items: stretch; gap: 2px; padding: 12px 20px 24px; background: rgba(5, 9, 20, 0.98); border-bottom: 1px solid var(--line); transform: translateY(-8px); opacity: 0; pointer-events: none; transition: 0.2s; }
    .nav > a:not(.btn) { font-size: 1.15rem; padding: 14px 8px; border-bottom: 1px solid var(--line); border-radius: 0; color: var(--text); }
    .nav-cta { margin: 14px 0 0; }
    .site-header.open .nav { transform: none; opacity: 1; pointer-events: auto; }
    .site-header.open .menu-btn :global(.i-open) { display: none; }
    .site-header.open .menu-btn :global(.i-close) { display: block; }
    .bar-right { margin-left: auto; }
  }
  @media (max-width: 420px) { .brand span { display: none; } }

  .site-footer { border-top: 1px solid var(--line); background: #03060e; padding: 64px 0 28px; margin-top: 0; }
  .foot-grid { display: grid; grid-template-columns: 1.1fr 1fr 1.25fr 0.9fr; gap: 36px; }
  .foot-brand img { width: 88px; height: 88px; border-radius: 50%; margin-bottom: 14px; }
  .motto { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; max-width: 260px; }
  .site-footer h4 { font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 14px; }
  .site-footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .site-footer ul a { text-decoration: none; color: #cfd8e8; font-size: 1rem; overflow-wrap: anywhere; }
  .site-footer ul a:hover { color: var(--cyan); }
  .foot-social { display: flex; gap: 10px; }
  .foot-social a { width: 46px; height: 46px; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--line-strong); color: var(--text); }
  .foot-social a:hover { border-color: var(--cyan); color: var(--cyan); }
  .foot-bottom { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-top: 48px; padding-top: 22px; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.92rem; }
  .foot-bottom a { color: var(--muted); }
  @media (max-width: 860px) { .foot-grid { grid-template-columns: 1fr 1fr; } .foot-brand { grid-column: 1 / -1; } }
  @media (max-width: 480px) { .foot-grid { grid-template-columns: 1fr; } }

  .wa-float { position: fixed; right: 18px; bottom: 18px; z-index: 60; display: inline-flex; align-items: center; gap: 8px; padding: 12px 18px 12px 14px; border-radius: 999px; background: var(--wa); color: #05290f; font-weight: 700; text-decoration: none; box-shadow: 0 12px 30px -8px rgba(37, 211, 102, 0.6); transition: transform 0.15s; }
  .wa-float:hover { transform: translateY(-2px) scale(1.02); }
  @media (max-width: 600px) { .wa-float span { display: none; } .wa-float { padding: 14px; } }
</style>
